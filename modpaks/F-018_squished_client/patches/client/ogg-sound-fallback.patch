+// Custom: a missing .wav falls back to the same name with .ogg, and the other way round, much as models accept .mdx
+// for .m2. Clients whose sounds were converted to Ogg Vorbis then play them without changing SoundEntries.dbc.
+static bool OpenAlternateSoundFile(const char* filename, SFileImpl** file, FMOD_CREATESOUNDEXINFO* exinfo) {
+    const char* extension = SStrChrR(const_cast<char*>(filename), '.');
+
+    if (!extension) {
+        return false;
+    }
+
+    const char* replacement;
+
+    if (!SStrCmpI(extension, ".wav", STORM_MAX_STR)) {
+        replacement = ".ogg";
+    } else if (!SStrCmpI(extension, ".ogg", STORM_MAX_STR)) {
+        replacement = ".wav";
+    } else {
+        return false;
+    }
+
+    char path[260];
+    size_t stem = static_cast<size_t>(extension - filename);
+
+    if (stem + 5 > sizeof(path)) {
+        return false;
+    }
+
+    memcpy(path, filename, stem);
+    memcpy(path + stem, replacement, 5);
+
+    if (!SFile::OpenEx(nullptr, path, 1, file)) {
+        return false;
+    }
+
+    // The type was suggested from the requested extension; let FMOD detect the real one.
+    exinfo->suggestedsoundtype = FMOD_SOUND_TYPE_UNKNOWN;
+    return true;
+}
