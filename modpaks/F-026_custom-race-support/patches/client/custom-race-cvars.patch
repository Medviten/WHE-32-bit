+// Custom: Cataclysm-style altered forms. alteredFormRaces lists "race=alteredRace" pairs (e.g. "22=23" (retail Worgen = Gilnean)),
+// standing in for Cata's ChrRaces.m_alteredFormRaceID. Such a race's second form is drawn as a real character of the
+// altered race with the same customization choices (in game when its display is the altered race's own model, and
+// in the barber shop and character creation previews).
+static uint8_t s_alteredFormRace[256];
+static uint8_t s_helmetRace[256];
+
+// Custom: fills a table from "race=otherRace" pairs
+static void ParseRacePairs(const char* value, uint8_t (&table)[256]) {
+    memset(table, 0, sizeof(table));
+
+    const char* cursor = value ? value : "";
+
+    while (*cursor) {
+        char* end;
+        long race = strtol(cursor, &end, 10);
+
+        if (end == cursor) {
+            cursor++;
+            continue;
+        }
+
+        cursor = end;
+
+        while (*cursor == ' ') {
+            cursor++;
+        }
+
+        if (*cursor != '=') {
+            continue;
+        }
+
+        cursor++;
+        long altered = strtol(cursor, &end, 10);
+
+        if (end == cursor) {
+            continue;
+        }
+
+        cursor = end;
+
+        if (race > 0 && race < 256 && altered > 0 && altered < 256 && race != altered) {
+            table[race] = static_cast<uint8_t>(altered);
+        }
+    }
+}
+
+bool AlteredFormRacesCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    ParseRacePairs(value, s_alteredFormRace);
+
+    return true;
+}
+
+uint32_t ClientGetAlteredFormRace(uint32_t race) {
+    return race < sizeof(s_alteredFormRace) ? s_alteredFormRace[race] : 0;
+}
+
+// Custom: HelmetGeosetVisData's hide masks have one bit per race ID, so only IDs below 32 have a bit of their own.
+// helmetRaces lists "race=copiedRace" pairs choosing whose bit a race uses instead, for the NPC races F-008 moved above
+// the playable range and for not-playable altered forms. A race above 31 that isn't listed has no bit: its helmets
+// hide nothing.
+bool HelmetRacesCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    ParseRacePairs(value, s_helmetRace);
+
+    return true;
+}
+
+uint32_t ClientGetHelmetRace(uint32_t race) {
+    return race < sizeof(s_helmetRace) && s_helmetRace[race] ? s_helmetRace[race] : race;
+}
+
+// Custom: shapeshiftSkinColorRaces lists the races whose shapeshift form models follow skin (fur) color rather than
+// hair color in player_shapeshift_model. Empty (the default) reads them from DBFilesClient\ShapeshiftSkinColorRaces.csv,
+// which WHE's build-dbc.sh exports from the server's player_race_template, so they follow the manifest's race IDs. It's
+// read on first use, once the MPQs are open; Tauren are the only ones without the file.
+static bool s_shapeshiftSkinColorRace[256];
+static bool s_shapeshiftSkinColorFromFile = false;
+
+static void ParseShapeshiftSkinColorRaces(const char* cursor) {
+    while (*cursor) {
+        char* end;
+        long race = strtol(cursor, &end, 10);
+
+        if (end == cursor) {
+            cursor++;
+            continue;
+        }
+
+        cursor = end;
+
+        if (race > 0 && race < 256) {
+            s_shapeshiftSkinColorRace[race] = true;
+        }
+    }
+}
+
+bool ShapeshiftSkinColorRacesCallback(CVar* var, const char* oldValue, const char* value, void* arg) {
+    memset(s_shapeshiftSkinColorRace, 0, sizeof(s_shapeshiftSkinColorRace));
+
+    s_shapeshiftSkinColorFromFile = !value || !*value;
+    ParseShapeshiftSkinColorRaces(value ? value : "");
+
+    return true;
+}
+
+bool ClientShapeshiftUsesSkinColor(uint32_t race) {
+    if (s_shapeshiftSkinColorFromFile) {
+        s_shapeshiftSkinColorFromFile = false;
+
+        char* data;
+        uint32_t size;
+
+        if (SFile::LoadFile("DBFilesClient\\ShapeshiftSkinColorRaces.csv", reinterpret_cast<void**>(&data), &size, 1, nullptr) && data) {
+            ParseShapeshiftSkinColorRaces(data);
+            SFile::Unload(data);
+        } else {
+            s_shapeshiftSkinColorRace[6] = true;
+        }
+    }
+
+    return race < sizeof(s_shapeshiftSkinColorRace) && s_shapeshiftSkinColorRace[race];
+}
+
+// Custom: creatureSkinRaces lists races whose models use their skin texture's whole layout, like creature models made
+// playable (Murloc, Slime Giant, Centaur and the CoA Custom races). Armour textures are not composited onto them: they would land wherever the
