+    if (!alteredRec) {
+        return nativeId;
+    }
+
+    int32_t displayId = this->m_unit->m_unitFieldBytes0[2] ? alteredRec->m_femaleDisplayID : alteredRec->m_maleDisplayID;
+    return displayId ? displayId : nativeId;
+}
