diff --git a/src/server/apps/worldserver/worldserver.conf.dist b/src/server/apps/worldserver/worldserver.conf.dist
index 94e787747..a7397c4bd 100644
--- a/src/server/apps/worldserver/worldserver.conf.dist
+++ b/src/server/apps/worldserver/worldserver.conf.dist
@@ -4569,6 +4569,16 @@ AllowTwoSide.Interaction.Arena = 0
 
 AllowTwoSide.Interaction.Auction = 0
 
+#
+#    AllowTwoSide.EnemyTerritory
+#        Description: Faction Free: do not treat the other faction's zones as hostile territory,
+#                     so entering an enemy capital (or, on PvP realms, any enemy zone) does not
+#                     flag players for PvP.
+#        Default:     1 - (Enabled)
+#                     0 - (Disabled, stock behaviour)
+
+AllowTwoSide.EnemyTerritory = 1
+
 #
 #    TalentsInspecting
 #        Description: Allow inspecting characters from the opposing faction.
diff --git a/src/server/game/Entities/Player/PlayerUpdates.cpp b/src/server/game/Entities/Player/PlayerUpdates.cpp
index 481a18266..6571e3d50 100644
--- a/src/server/game/Entities/Player/PlayerUpdates.cpp
+++ b/src/server/game/Entities/Player/PlayerUpdates.cpp
@@ -1321,13 +1321,16 @@ void Player::UpdateZone(uint32 newZone, uint32 newArea, bool force)
     // in PvE, only opposition team capital
     switch (zone->team)
     {
+    // Faction Free (by Gitdalisar): with AllowTwoSide.EnemyTerritory, faction zones are never hostile
     case AREATEAM_ALLY:
         pvpInfo.IsInHostileArea =
+            !sWorld->getBoolConfig(CONFIG_ALLOW_TWO_SIDE_ENEMY_TERRITORY) &&
             GetTeamId(true) != TEAM_ALLIANCE &&
             (sWorld->IsPvPRealm() || zone->flags & AREA_FLAG_CAPITAL);
         break;
     case AREATEAM_HORDE:
         pvpInfo.IsInHostileArea =
+            !sWorld->getBoolConfig(CONFIG_ALLOW_TWO_SIDE_ENEMY_TERRITORY) &&
             GetTeamId(true) != TEAM_HORDE &&
             (sWorld->IsPvPRealm() || zone->flags & AREA_FLAG_CAPITAL);
         break;
