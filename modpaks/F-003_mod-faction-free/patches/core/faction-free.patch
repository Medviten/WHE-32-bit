diff --git a/src/server/apps/worldserver/worldserver.conf.dist b/src/server/apps/worldserver/worldserver.conf.dist
index 17d37c6e7..93ebdb973 100644
--- a/src/server/apps/worldserver/worldserver.conf.dist
+++ b/src/server/apps/worldserver/worldserver.conf.dist
@@ -4578,6 +4578,35 @@ AllowTwoSide.Interaction.Arena = 0
 
 AllowTwoSide.Interaction.Auction = 0
 
+#
+#    AllowTwoSide.EnemyTerritory
+#        Description: Faction Free: do not treat the other faction's zones as hostile territory,
+#                     so entering an enemy capital (or, on PvP realms, any enemy zone) does not
+#                     flag players for PvP.
+#        Default:     1 - (Enabled)
+#                     0 - (Disabled, stock behaviour)
+
+AllowTwoSide.EnemyTerritory = 1
+
+#
+#    AllowTwoSide.QuestReputation
+#        Description: Faction Free: let quests reward reputation with factions that are hostile to
+#                     the player's team, so the other faction's reputations can be earned.
+#        Default:     1 - (Enabled)
+#                     0 - (Disabled, stock behaviour)
+
+AllowTwoSide.QuestReputation = 1
+
+#
+#    AllowTwoSide.KillReputation
+#        Description: Faction Free: let kills that normally reward reputation by team (e.g. Honor
+#                     Hold or Thrallmar) reward both teams' factions. While championing a faction,
+#                     kills keep rewarding it once.
+#        Default:     1 - (Enabled)
+#                     0 - (Disabled, stock behaviour)
+
+AllowTwoSide.KillReputation = 1
+
 #
 #    TalentsInspecting
 #        Description: Allow inspecting characters from the opposing faction.
