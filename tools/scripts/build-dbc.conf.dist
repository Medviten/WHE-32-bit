MODPAKS="/path/to/WHE-32-bit/modpaks"
DBCTOOL="/path/to/dbctool"
ORIGINAL_DBC="/path/to/dbctool/originaldbc"
LOCAL_SERVER_DBC="/path/to/server/data/dbc"

MYSQL_HOST="127.0.0.1"
MYSQL_PORT="63306"
MYSQL_USER="acore"
MYSQL_PASSWORD="acore"

DBC_DATABASE="dbc"

SERVER_HOST="medviten@100.110.63.66"
SERVER_DBC="/path/to/server/data/dbc"

EXTRA_SQL_DATABASES=("test_world")
EXTRA_SQL_PATTERNS=("sql/db-world/base/*.sql")
EXTRA_SQL_DUMPS=("/path/to/ac-worldserver.sql")

LOCAL_SOURCE_DIR="/home/youruser/dev/wow-modpaks"
REMOTE_SOURCE_DIR="/home/youruser/wow"

# Clean baseline database dump instead of reimporting DBCs every time
DBC_BASELINE="/path/to/dbc-baseline.sql"

# Where build-patch.sh writes combined-<target>.patch: the
# patches/<target>/ folders of the modpaks in the manifest (see README).
# Defaults to this directory.
#PATCH_OUTPUT_DIR="/path/to/combined/patches"

# The world database (one of EXTRA_SQL_DATABASES). Needed for the world_db
# placeholder and for exporting PlayerShapeshiftModel.csv and
# ShapeshiftSkinColorRaces.csv for the client, which go with the DBCs in
# SERVER_DBC unless SHAPESHIFT_MODEL_CSV or SKIN_COLOR_RACES_CSV say otherwise.
#WORLD_DATABASE="test_world"
#SHAPESHIFT_MODEL_CSV="/path/to/server/data/dbc/PlayerShapeshiftModel.csv"
# It is also needed to export ShapeshiftSkinColorRaces.csv, for the client's
# shapeshiftSkinColorRaces, from player_race_template.
#SKIN_COLOR_RACES_CSV="/path/to/server/data/dbc/ShapeshiftSkinColorRaces.csv"

# build-dbc.sh stops if the manifest assigns race IDs above this.
#MAX_RACE_ID=31

# The client's stock Textures\Minimap\md5translate.trs (extract it from the
# client's MPQs). When set, the md5translate rows of the modpaks' dbc/ SQL are
# added to it and written to MINIMAP_TRS, by default md5translate.trs in
# SERVER_DBC, for the client's Textures\Minimap. Leave it unset to skip that.
#ORIGINAL_TRS="/path/to/stock/md5translate.trs"
#MINIMAP_TRS="/path/to/server/data/dbc/md5translate.trs"
