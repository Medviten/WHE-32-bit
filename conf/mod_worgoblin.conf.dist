[worldserver]

########################################
# WORGOBLIN MODULE CONFIGURATION
########################################
#
#    Announce.enable (bool)
#        Description: Announce to players on login that this server runs the Worgoblin and High Elf modules.
#        Default:     1

Announce.enable = 1

#
#    Worgoblin.RunningWild.FreeApprentice (bool)
#        Description: If enabled, Worgen auto-learn Apprentice Riding at level 20. Worgen learn Running Wild at level 20
#                     either way; its speed follows riding skill (+60%, or +100% from Journeyman Riding).
#                     Does not affect Death Knights, who start with Journeyman-level riding skill.
#        Default:     1

Worgoblin.RunningWild.FreeApprentice = 1

#
#    Worgoblin.RunningWild.FreeJourneyman (bool)
#        Description: If enabled, Worgen auto-learn Journeyman Riding (which makes Running Wild +100%) at level 40,
#                     in addition to whatever FreeApprentice does. If disabled, Worgen must train Journeyman normally.
#                     Does not affect Death Knights, who start with Journeyman-level riding skill.
#        Default:     1

Worgoblin.RunningWild.FreeJourneyman = 1

#
#    Worgoblin.StartingPet.Enable (bool)
#        Description: If enabled, new hunters start with a pet (needs modpak F-128). Hunters who already have one keep it
#                     when this is turned off.
#        Default:     1

Worgoblin.StartingPet.Enable = 1
